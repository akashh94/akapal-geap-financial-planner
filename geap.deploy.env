# Office/general environment — self-contained config for the office deployment.
# Sourced by deploy.a2a.sh.
# Every variable here is also present in deploy.personal.env (with different
# values), so picking which file you source is what picks which environment
# you deploy to.
#
# Values are assigned outright rather than with "${VAR:-default}". The ambient
# environment can already carry them — an injected .env, a shell export — and an
# agent's region cannot be changed after creation, so the file has to win.
# Locations are derived from REGION so they cannot drift apart from it.

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="labs-gcp-msls-16495-1782829337"
export REGION="us-east1"

# --- GCS staging bucket -----------------------------------------------------
# Required by the SDK object deploy: Agent Runtime stages the pickled agent, the
# requirements file and the bundled `app` package here. deploy_a2a.py reads it
# with os.environ["STAGING_BUCKET"], so it must be defined or the deploy raises
# KeyError before it reaches the SDK.
# TODO: confirm this bucket exists in the office project.
export STAGING_BUCKET="gs://geap-staging-1782829337"

# --- Model -----------------------------------------------------------------
export AGENT_MODEL="${AGENT_MODEL:-gemini-2.5-flash}"
export MODEL_LOCATION="${MODEL_LOCATION:-global}"

# --- Remote MCP portfolio server --------------------------------------------
# The deployed portfolio server speaks Streamable HTTP at /mcp (not SSE).
# TODO: confirm the office MCP service URL; update if different.
export MCP_PORTFOLIO_URL="https://mcp-portfolio-492310803820.us-east1.run.app/mcp"

# --- MCP portfolio server via Agent Registry --------------------------------
# Preferred connection: the planner resolves the portfolio MCP endpoint from
# the Agent Registry (discovery + auth) instead of the hardcoded URL above.
# NOTE: the office project must register its portfolio MCP server in its own
# Agent Registry at this name.
export MCP_REGISTRY_PROJECT_ID="${PROJECT_ID}"
export MCP_REGISTRY_LOCATION="${REGION}"
export MCP_REGISTRY_SERVER="projects/${PROJECT_ID}/locations/${REGION}/mcpServers/agentregistry-00000000-0000-0000-b624-c3ae387e34b9"

# --- Vertex AI Memory Bank ---------------------------------------------------
# Left empty on purpose: Agent Runtime injects GOOGLE_CLOUD_AGENT_ENGINE_ID and
# get_memory_service() falls back to the planner's own engine's Memory Bank.
# Set it only to point at a different engine's Memory Bank.
export MEMORY_BANK_ID=""
