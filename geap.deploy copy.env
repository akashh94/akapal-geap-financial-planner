# Office/general environment — self-contained config for the office deployment.
# Sourced by deploy.a2a.sh.
# Every variable here is also present in deploy.personal.env (with different
# values), so picking which file you source is what picks which environment
# you deploy to.
#
# All values use "${VAR:-default}" so you can still override per-run:
#   PROJECT_ID=my-project ./deploy.a2a.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="labs-gcp-msls-16495-1782829337"
export REGION="us-east1"

# --- GCS staging bucket -----------------------------------------------------
# Required by the SDK object deploy: Agent Runtime stages the pickled agent, the
# requirements file and the bundled `app` package here. deploy_a2a.py reads it
# with os.environ["STAGING_BUCKET"], so it must be defined or the deploy raises
# KeyError before it reaches the SDK.
# TODO: set the office staging bucket. Do NOT point this at the personal
# project's bucket — the object deploy stages into whatever project owns it.
# The placeholder fails loudly on first deploy rather than silently staging
# into the wrong project.
export STAGING_BUCKET="${STAGING_BUCKET:-gs://geap-staging-1782829337}"

# --- Model -----------------------------------------------------------------
export AGENT_MODEL="${AGENT_MODEL:-gemini-2.5-flash}"
export MODEL_LOCATION="${MODEL_LOCATION:-global}"

# --- Remote MCP portfolio server --------------------------------------------
# The deployed portfolio server speaks Streamable HTTP at /mcp (not SSE).
# TODO: confirm the office MCP service URL; update if different.
export MCP_PORTFOLIO_URL="${MCP_PORTFOLIO_URL:-https://mcp-portfolio-492310803820.us-east1.run.app/mcp}"

# --- MCP portfolio server via Agent Registry --------------------------------
# Preferred connection: the planner resolves the portfolio MCP endpoint from
# the Agent Registry (discovery + auth) instead of the hardcoded URL above.
# NOTE: the office project must register its portfolio MCP server in its own
# Agent Registry and set MCP_REGISTRY_SERVER to its full resource name
# (format: projects/<project>/locations/<location>/mcpServers/<name>).
export MCP_REGISTRY_PROJECT_ID="${MCP_REGISTRY_PROJECT_ID:-${PROJECT_ID}}"
export MCP_REGISTRY_LOCATION="${MCP_REGISTRY_LOCATION:-us-east1}"
export MCP_REGISTRY_SERVER="${MCP_REGISTRY_SERVER:-projects/labs-gcp-msls-16495-1782829337/locations/us-east1/mcpServers/agentregistry-00000000-0000-0000-b624-c3ae387e34b9}"

# --- Vertex AI Memory Bank ---------------------------------------------------
# Memory Bank instance for long-term planner memory. Leave empty on Agent
# Runtime: the platform injects GOOGLE_CLOUD_AGENT_ENGINE_ID and
# get_memory_service() falls back to the planner's own engine's Memory Bank.
# Set it explicitly only to point at a different engine's Memory Bank.
export MEMORY_BANK_ID="${MEMORY_BANK_ID:-}"
